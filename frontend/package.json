{
  "name": "kubenova",
  "productName": "KubeNova",
  "version": "1.0.5",
  "description": "AI-powered, enterprise-ready Kubernetes IDE",
  "author": {
    "name": "KubeNova",
    "email": "mahmoudkamal448@gmail.com"
  },
  "license": "Apache-2.0",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build:renderer": "vite build",
    "build:backend": "node scripts/build-backend.cjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build:backend && npm run build && electron-builder",
    "dist:win": "npm run build:backend -- --target=windows && npm run build && electron-builder --win",
    "dist:mac": "npm run build:backend -- --target=darwin && npm run build && electron-builder --mac",
    "dist:linux": "npm run build:backend -- --target=linux && npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "io.kubenova.ide",
    "productName": "KubeNova",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "KubeNova <mahmoudkamal448@gmail.com>",
      "executableName": "kubenova"
    },
    "artifactName": "KubeNova-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Mahmoudkamal448",
        "repo": "infrastructue-rebo"
      }
    ],
    "nsis": {
      "artifactName": "KubeNova-Setup-${version}-win-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "KubeNova-Portable-${version}-win-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/merge": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.14",
    "@tanstack/react-virtual": "^3.10.8",
    "@uiw/react-codemirror": "^4.23.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "lucide-react": "^0.453.0",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "homepage": "https://github.com/mahmoudkamal448/infrastructue-rebo"
}